#!/usr/bin/env bash
# crew — run several coding agents as a crew in tmux panes.
#
# Messages are files under ~/.crew/<name>/; tmux send-keys is only the
# doorbell that types a one-line notice into the recipient's prompt.
# Written for macOS bash 3.2 (no associative arrays).
set -euo pipefail

CREW_HOME="${CREW_HOME:-$HOME/.crew}"
# Templates and the web viewer live in ../share/crew next to the real script
# (the repo checkout, even when bin/crew is symlinked onto PATH).
_self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
CREW_SHARE="${CREW_SHARE:-$(cd "$(dirname "$_self")/../share/crew" 2>/dev/null && pwd || printf '%s' "$HOME/.local/share/crew")}"
BOOT_WAIT="${CREW_BOOT_WAIT:-30}"   # seconds to wait for an agent CLI to settle
RING_MAX=500                         # longer messages ring with a pointer instead

die() { printf 'crew: %s\n' "$*" >&2; exit 1; }
now() { date '+%Y-%m-%dT%H:%M:%S'; }
oneline() { printf '%s' "$*" | tr '\t\n\r' '   '; }
# Duration: integer seconds, optionally suffixed s/m/h/d. Zero is allowed;
# callers that need a positive value check it themselves.
duration() {
  local value="$1" factor=1
  case "$value" in
    *s) value=${value%s} ;;
    *m) value=${value%m}; factor=60 ;;
    *h) value=${value%h}; factor=3600 ;;
    *d) value=${value%d}; factor=86400 ;;
  esac
  case "$value" in ''|*[!0-9]*) return 1 ;; esac
  value="${value#"${value%%[!0]*}"}"; [ -n "$value" ] || value=0
  [ ${#value} -le 6 ] || return 1
  printf '%s' "$((10#$value * factor))"
}
# BSD awk's substr counts bytes. Bash counts characters in a UTF-8 locale,
# including when the caller uses LC_ALL=C. macOS ships en_US.UTF-8.
truncate_text() { local LC_ALL=en_US.UTF-8; printf '%s' "${1:0:$2}"; }
take_lock() { # dir tries — mkdir lock, retried every 0.1 s; fails after <tries>
  local i=0
  until mkdir "$1" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -lt "$2" ] || return 1
    sleep 0.1
  done
}

usage() {
  cat <<'EOF'
crew — coding agents working together in tmux

  crew up <name> [options] role=cli ...               new window, one pane per agent
      --self <role>    the calling pane joins as <role> (an agent can start its own crew)
      --here           split the calling window instead of opening a new one
      --in <session>   tmux session for the new window (default: the caller's)
      --no-watch       don't start the detached watcher that rings the lead
      --wake-on-limit  opt in to waking lead after a recognised usage reset
      --handover-on-limit <cli spec>  also hand lead over to a new pane running
                       <cli spec> when its reset is over --max-wait (default 6h) or unreadable
  crew adopt <name> role=<pane> ...                   use panes you already have (%7, .2, 6.1)
  crew add [--cwd <dir>] role=<cli spec|%pane|fork:role> ...   add agents to a running crew
                                                      (spawn, adopt, or fork; --cwd is where the
                                                      added roles work: their new panes start
                                                      there and their tasks' gates run there.
                                                      A fork:role starts in its source role's
                                                      directory unless --cwd says otherwise)
  crew rebind <role> [pane]                           point a role at another pane (default: this one)
  crew session <role> [id]                            show or pin a role's native session ID
  crew resume <role>                                  resume that role in this unbound tmux pane
  crew override <role> <replacement-role|pane>       hand a role's ongoing work to another crew agent
  crew override <role>=<cli spec|%pane>              spawn or adopt a successor, then hand over
  crew remove <role> [--keep-pane]                    drop a role: block open tasks, close/unlabel its pane
  crew send <role[,role…]|@all|you> <message>         message agents (@all: lead/you only)
  crew say <role[,role…]|@all> <message>              human message; run in a terminal outside crew panes
  crew note <text>                                    add a note to the timeline
  crew task add --to <role> [--dep T1] [--out out/x.md] [--gate "<cmd>"] [--cwd <dir>] [--msg ..] <title>
                                                      ({id} → new id; warns on review-only roles)
  crew task set <id> <queued|working|done|blocked|needs-input> [--out <file>] [--evidence <file>] [--force]
                                                      (owner's done runs the task's --gate)
  crew task cancel <id> [--reason "<text>"]           close a task as cancelled, list its dependents (lead/you)
  crew task dep <id> <T1,T2|->                        replace a task's dependencies (lead/you)
  crew task next-id                                   id the next task add will use
  crew lock [--name build] [--max N] -- <cmd...>     crew-wide command semaphore (default max 1)
  crew board                                          task board
  crew status                                         agents + board, stuck/error notes and context/quota
  crew ui                                             terminal dashboard: status, tasks and live pane preview (needs bun)
  crew watch [--every 120] [--quiet-after 10m] [--ring] [--wake-on-limit]
             [--handover-on-limit <cli spec> [--max-wait 6h]]
                                                      foreground state-change notices (or doorbells to lead)
  crew at <HH:MM|+30m> <role> <message>               schedule one guarded doorbell (local time)
  crew every <30m> <role> <message>                    repeat guarded doorbells until cancelled
  crew timers [cancel <id>]                            list or cancel this crew's timers
  crew log [-f] [-n N]                                channel timeline
  crew peek <role> [lines]                            last lines of an agent's pane
  crew inbox [role] [--last [N]] [--from <role>] [--since HH:MM]
                                                      whole entries of a role's inbox
  crew web [--port N] [--open] [--allow-send]         browser view on 127.0.0.1 (needs bun); read-only
                                                      unless --allow-send adds a compose box
  crew restyle                                        re-apply the pane border format to the crew's windows
  crew down                                           close the crew (files are kept)
  crew ls [--live]                                    projects, pane liveness, tasks and last activity
  crew sweep [--apply] [--delete-older <age>]        report stale crews; --apply marks them ended;
                                                      --delete-older 14d (its own mode) lists ended
                                                      crew folders older than <age> (s/m/h/d) and
                                                      deletes them only with --apply
  crew whoami | path

  -s <name> before the command picks a crew explicitly.
  Examples:
    crew up voucher "lead=claude --allowedTools 'Bash(crew:*)'" impl=codex rev=pi
    crew up pr1068 --self lead impl=codex rev=pi
    crew adopt pr1068 lead=%4 rev=%9 rev2=%11
    crew -s pr1068 add rev3=pi impl2=%12
    crew -s voucher override lead impl                impl takes over when lead hits a limit
    crew -s voucher override lead=pi                  spawn a fresh lead in one step

  Agents run `crew send` from their shell tool, so each needs permission to:
    claude  pre-allow it: claude --allowedTools 'Bash(crew:*)'  (or use auto mode)
    codex   its default sandbox can't reach tmux, so its messages don't ring;
            pass flags in the role spec, e.g. keep the sandbox but let it
            reach tmux and write ~/.crew:
              "impl=codex -c sandbox_workspace_write.network_access=true
                 -c 'sandbox_workspace_write.writable_roots=[\"$HOME/.crew\"]'"
            (keep the single quotes: zsh globs a bare [...] and the command fails)
            or run it fully unsandboxed (no approvals either):
              "impl=codex --dangerously-bypass-approvals-and-sandbox"
    pi      has no permission prompts

  Senders: a crew pane is its role; a terminal (tty) outside the crew is "you";
  anything else (e.g. an agent that isn't in the crew) is "outside". This is a
  label to stop accidental relays, not a security boundary. `crew whoami`
  prints why the caller resolved (a `why:` line); a send labelled outside also
  warns on stderr with that reason. Unresolved task setters fail before any gate
  or board write. For a dead/foreign tool-shell pane, use explicit per-call hints:
    CREW_SESSION=<name> CREW_AGENT=<your-role> crew -s <name> whoami
  Verify your own role before using that prefix for other crew calls.

  --self/--here require a live TMUX_PANE. --self prints its adopted pane and
  CLI; filter/pager CLIs warn because a temporary command pane may be bound.

  After a restart: use ls/status to find gone/reused roles. In a new unbound
  pane, session <role> shows its conversation ID and resume <role> restores it.
  Use rebind only when the agent conversation is already running elsewhere.
  A matching CLI/pane id alone never establishes ownership.

  Agent detection prefers known Claude/Codex/pi processes over tty helpers,
  including caffeinate, nice, env and time. Launch specs stay unchanged.

  Doorbells wait up to CREW_RING_WAIT seconds for a recognised draft to clear
  (default 30, capped at 3600); skipped rings warn and leave the message in the
  inbox. CREW_RING_WAIT=0 checks once and refuses a busy editor immediately;
  web sends use it to avoid waiting. Dialog and tmux mode checks stay active.
  A ringing watcher retries held deliveries as one coalesced inbox reminder
  after the editor clears. Stdout watch never replays pending reminders.
  Pi's Working spinner and blank editor padding are not drafts.
  Startup retries one Enter only for the complete original intro; Codex composer
  continuation rows are joined for that comparison. Other drafts stay untouched.

  Task dependencies accept comma-separated ids (--dep T1,T2). Completing the
  last dependency notifies owners of queued tasks through the guarded inbox
  path. Tasks stay queued until their owners start; repeated done is quiet.
  A cancelled task is closed but never satisfies a dependency: `task cancel`
  lists the dependents so the lead can re-point them with `task dep`. Editing
  deps to remove the last unmet one notifies a queued owner once. Closed rows
  keep their number; `next-id` is the highest existing numeric id + 1.

  Working directories: a task records the directory of its owner at add time
  (or `task add --cwd`), and its gate runs there, so a task taken over by
  another role still checks the original worktree. `crew add --cwd <dir>`
  records a role's directory and starts its new panes there. Plain additions
  default to the crew directory; forks inherit their source role's directory.
  Role directories follow swapped panes and sessions on override; task gate
  directories stay fixed. Session lookups and resume use the role directory.

  Watch defaults: --every 120 seconds, --quiet-after 10m of unchanged pane/task
  text before idle notices. Errors are immediate; the empty-board notice fires
  only when the board goes from open tasks to none, never on a first scan.
  Durations accept seconds or s/m/h/d; --quiet-after 0 reports idle immediately.
  --ring uses the guarded lead doorbell instead of stdout. Ctrl-C stops watch.
  A crew with a lead role also gets one detached watcher from `crew up`
  (120 s scans, same rules, ringing the lead); it appears in `crew timers`
  (NEXT is '-') and `crew down` stops it. --no-watch skips it;
  CREW_WATCH_EVERY=<duration> changes its scan interval.
  --wake-on-limit (up, or watch --ring) opts in to one guarded retry for a
  lead after a recognised reset time + 60s grace. Codex uses
  'try again at H:MM AM/PM' (optionally 'on October 25');
  Claude 'resets 3pm (Area/City)' or 'resets Oct 31 at 3:30pm'. Named
  timezones are honoured; otherwise local time. A clock alone is its next
  occurrence; a dated (weekly) reset is that day.
  Dispatch waits for a scan and idle prompt.
  The same visible banner is retried once, including across watcher restarts.
  --handover-on-limit <cli spec> (implies --wake-on-limit) decides by the wait,
  not the limit's name: a reset within --max-wait (default 6h) waits and wakes;
  a later or unreadable one, still shown on an idle lead 5 minutes later, runs
  `crew override lead=<cli spec>` as 'watch' once. The spec is used exactly
  as given. A lead started this way never hands over again; it waits.
  Workers are never auto-woken: their alert includes the reset time when known;
  lead decides whether to wait or hand over, explicitly choosing a suitable model.
  No model is chosen automatically. Unknown reset formats stay manual unless a
  handover spec is set.

  Timers run detached, recorded under the crew timers/ directory. Delays use
  seconds or s/m/h/d suffixes (positive integers). HH:MM uses the next local
  occurrence.
  Repeats first fire after one interval; crew down cancels all timers. Rings
  inspect drafts once and skip contended doorbells; skipped rings remain in
  the inbox. A ringing watcher can retry them as a coalesced reminder; the
  timer worker itself does not retry missed doorbells.

  Lock slots live under the crew locks/<name>/ directory. Each name keeps
  its first --max capacity; later callers must use the same value. Waiting
  prints to stderr; command arguments, streams and exit status are preserved.
  A surviving command keeps its slot if the wrapper dies. Dead/reused-pid
  slots are recovered automatically. Status lists wrapper and command pids.

  Files: ~/.crew/<name>/ (panes, cwd.tsv, board.tsv, channel.log, inbox/, out/, roles/, pending/)
  Role templates: share/crew/ next to this script (protocol.md, roles/<role>.md)
EOF
}

# ---------- session / identity ----------

pane_session() {
  local f
  for f in "$CREW_HOME"/*/panes; do
    [ -f "$f" ] || continue
    [ -f "$(dirname "$f")/ended" ] && continue
    if awk -F'\t' -v p="$1" '$2==p{found=1} END{exit !found}' "$f"; then
      basename "$(dirname "$f")"; return 0
    fi
  done
  return 1
}

resolve_session() {
  if [ -n "${SESSION_FLAG:-}" ]; then S="$SESSION_FLAG"
  elif [ -n "${CREW_SESSION:-}" ]; then S="$CREW_SESSION"
  elif [ -n "${TMUX_PANE:-}" ] && S=$(pane_session "$TMUX_PANE"); then :
  elif [ -f "$CREW_HOME/.current" ]; then S=$(cat "$CREW_HOME/.current")
  else die "no crew here (run inside a crew pane, or pass -s <name>)"; fi
  D="$CREW_HOME/$S"
  [ -d "$D" ] || die "unknown crew: $S"
  # Passive viewers must not pin the caller's native session as a side effect.
  [ "${1:-}" = --read-only ] || session_capture_current
}

# Caller identity: a crew role; else "you" when typed at a terminal (agents'
# shell tools have no tty) or sent from `crew web --allow-send`; else "outside".
# Advisory only: it keeps honest mistakes (relayed approvals, stale panes)
# visible, but any process can write the crew files directly.
# Sets ENV_WHY on every path so `crew whoami` (and an outside `crew send`)
# can say which check resolved or refused the caller.
env_identity_ok() {
  local pane other
  if [ -z "${CREW_AGENT:-}" ]; then ENV_WHY="no CREW_AGENT set"; return 1; fi
  if [ "${CREW_SESSION:-}" != "$S" ]; then ENV_WHY="CREW_SESSION=${CREW_SESSION:-unset} does not match crew $S"; return 1; fi
  pane=$(pane_of "$CREW_AGENT")
  if [ -z "$pane" ]; then ENV_WHY="no pane is bound to role $CREW_AGENT"; return 1; fi
  if ! owns_pane "$pane" "$CREW_AGENT"; then ENV_WHY="pane $pane is not owned by role $CREW_AGENT (gone or relabelled)"; return 1; fi
  if [ -z "${TMUX_PANE:-}" ]; then ENV_WHY="env CREW_AGENT=$CREW_AGENT, CREW_SESSION=$S; no TMUX_PANE"; return 0; fi
  if ! pane_id "$TMUX_PANE" >/dev/null; then ENV_WHY="env CREW_AGENT=$CREW_AGENT, CREW_SESSION=$S; TMUX_PANE $TMUX_PANE not found"; return 0; fi
  # Existing unlabelled/detached and unbound same-crew panes stay outside.
  other=$(tmux display-message -p -t "$TMUX_PANE" '#{@crew_session}' 2>/dev/null) || { ENV_WHY="TMUX_PANE $TMUX_PANE could not be inspected"; return 1; }
  if [ -n "$other" ] && [ "$other" != "$S" ]; then
    ENV_WHY="env CREW_AGENT=$CREW_AGENT, CREW_SESSION=$S; TMUX_PANE $TMUX_PANE belongs to crew $other"
    return 0
  fi
  if [ -n "$other" ]; then ENV_WHY="TMUX_PANE $TMUX_PANE is labelled for crew $S but bound to no role"
  else ENV_WHY="TMUX_PANE $TMUX_PANE is unlabelled"; fi
  return 1
}

resolve_me() {
  ME=""; VIA=""; WHY=""
  # Bindings override startup env after takeover; Codex tool shells may
  # inherit a missing/foreign TMUX_PANE and need the guarded env fallback.
  if [ -n "${TMUX_PANE:-}" ]; then ME=$(awk -F'\t' -v p="$TMUX_PANE" '$2==p{print $1; exit}' "$D/panes")
  fi
  if [ -n "$ME" ]; then WHY="pane $TMUX_PANE is bound to $ME"; return 0
  elif env_identity_ok; then ME="$CREW_AGENT"; WHY="$ENV_WHY"
  elif [ -t 0 ]; then ME=you; VIA=terminal; WHY="stdin is a terminal"
  elif [ "${CREW_VIA:-}" = web ]; then ME=you; VIA=web; WHY="web send (CREW_VIA=web)"
  else ME=outside; WHY="${ENV_WHY:-no identity signal}"; fi
}

# How a sender is shown in doorbells.
sender_label() {
  case "$ME" in
    you) printf 'you (%s)' "${VIA:-human}" ;;
    outside) printf 'outside%s (not in this crew)' "${TMUX_PANE:+ $TMUX_PANE}" ;;
    *) printf '%s' "$ME" ;;
  esac
}

roles() { awk -F'\t' '{print $1}' "$D/panes"; }
pane_of() { awk -F'\t' -v r="$1" '$1==r{print $2; exit}' "$D/panes"; }
meta() { awk -F'=' -v k="$1" '$1==k{sub(/^[^=]*=/, ""); print; exit}' "$D/meta"; }

# Working directory per role (worktree-per-worker). cwd.tsv holds only the
# roles that were given their own directory (`crew add --cwd`);
# every other role works in the crew's project directory from meta. Gates and
# session lookups ask for the role's directory, so two same-CLI workers in
# different worktrees never get confused for each other.
resolve_cwd_arg() { # flag dir -> physical absolute directory; dies on a bad or awkward path
  local flag="$1" dir="$2"
  [ -n "$dir" ] || die "$flag needs a directory"
  [ -d "$dir" ] || die "no such directory for $flag: $dir"
  # Physical (pwd -P) on purpose: agent CLIs key their session stores on
  # process.cwd(), so /tmp/tree and /private/tmp/tree must not be two trees.
  # The '%s/.' suffix is a newline marker: command substitution strips at most
  # one trailing newline, so the marker proves the cd worked; the substitution
  # result is validated (${dir%/.} removes the marker) before anything uses it.
  dir=$(cd -P "$dir" && printf '%s/.' "$PWD") || die "cannot enter $flag directory: $2"
  dir=${dir%/.}
  # One record per line, tab separated: these would corrupt it.
  case "$dir" in
    *$'\t'*) die "a working directory can't contain a tab: $dir" ;;
    *$'\n'*) die "a working directory can't contain a newline: $dir" ;;
  esac
  printf '%s' "$dir"
}
role_cwd() { # role -> absolute directory or the crew's project directory
  local dir=""
  [ ! -f "$D/cwd.tsv" ] || dir=$(awk -F'\t' -v r="$1" '$1==r{print $2; exit}' "$D/cwd.tsv")
  [ -n "$dir" ] || dir=$(meta cwd)
  printf '%s' "$dir"
}
record_role_cwd() { # role dir; caller holds the panes lock
  local tmp="$D/cwd.tsv.tmp"
  # One line per role, tab separated: a tab or newline in the path would corrupt
  # the record. The value travels in the environment because awk -v would eat
  # backslashes (`/home/a\b` arrived as a tab).
  case "$2" in
    ''|-) die "internal: empty working directory for $1" ;;
    *$'\t'*) die "a working directory can't contain a tab: $1" ;;
    *$'\n'*) die "a working directory can't contain a newline: $1" ;;
  esac
  [ -f "$D/cwd.tsv" ] || : > "$D/cwd.tsv"
  RECORD_ROLE="$1" RECORD_DIR="$2" awk -F'\t' -v OFS='\t' '
    $1==ENVIRON["RECORD_ROLE"] { if (!seen) { $2=ENVIRON["RECORD_DIR"]; print }; seen=1; next }
    { print }
    END { if (!seen) print ENVIRON["RECORD_ROLE"], ENVIRON["RECORD_DIR"] }' "$D/cwd.tsv" > "$tmp"
  mv "$tmp" "$D/cwd.tsv"
}
forget_role_cwd() { # role; caller holds the panes lock
  [ -f "$D/cwd.tsv" ] || return 0
  awk -F'\t' -v r="$1" '$1!=r' "$D/cwd.tsv" > "$D/cwd.tsv.tmp"
  mv "$D/cwd.tsv.tmp" "$D/cwd.tsv"
}

log_line() { # kind from to text
  printf '%s\t%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "$3" "$(oneline "$4")" >> "$D/channel.log"
}

# ---------- tmux helpers ----------

# Pane readers, the doorbell ring and its draft hold.
. "$CREW_SHARE/pane.sh"
. "$CREW_SHARE/limit.sh"
. "$CREW_SHARE/watch.sh"
. "$CREW_SHARE/timers.sh"
. "$CREW_SHARE/semaphore.sh"
. "$CREW_SHARE/tasks.sh"

# Program name for labels: "codex --sandbox …" → codex. Claude's process is
# named after its version (e.g. 2.1.284), so a bare version means claude.
short_cli() {
  local w="${1%% *}"; w="${w##*/}"
  case "$w" in [0-9]*.[0-9]*) w=claude ;; esac
  printf '%s' "$w"
}

. "$CREW_SHARE/sessions.sh"

# The agent program running in a pane, from its tty's process list (the first
# non-shell process). Better than #{pane_current_command}, which shows claude
# as its version (2.1.284) and pi as node. A known agent wins over helpers
# that started earlier on the same tty (a hook's `caffeinate` made the lead
# read as unknown, so its draft hold was skipped and a doorbell landed in it).
detect_cli() { # pane
  local tty w rest first=""
  tty=$(tmux display-message -p -t "$1" '#{pane_tty}' 2>/dev/null) || return 0
  while read -r w rest; do
    w="${w##*/}"; w="${w#-}"
    case "$w" in zsh|bash|sh|fish|dash|login|tmux|"") continue ;; esac
    case "$(short_cli "$w")" in claude|codex|pi|command-code) printf '%s' "$w"; return 0 ;; esac
    [ -n "$first" ] || first="$w"
  done <<EOF
$(ps -o args= -t "${tty#/dev/}" 2>/dev/null)
EOF
  printf '%s' "$first"
}
# "%7", ".2", "6.1" → pane id. tmux 3.5 prints nothing and exits 0 for a
# missing pane, so empty output counts as not found.
pane_id() { # ref
  local p; p=$(tmux display-message -p -t "$1" '#{pane_id}' 2>/dev/null) && [ -n "$p" ] && printf '%s' "$p"
}
pane_cli() { # pane — detected program, else tmux's view
  local c; c=$(detect_cli "$1")
  [ -n "$c" ] || c=$(tmux display-message -p -t "$1" '#{pane_current_command}')
  printf '%s' "$c"
}

# Model name from the agent's status bar (claude "Opus 5.5", codex "GPT-6-Sol",
# pi "provider/model • effort"). Screen-scraped, so it follows /model switches.
MODEL_RE='(Opus|Sonnet|Haiku|Fable) [0-9.]+|GPT-[A-Za-z0-9.-]+|gpt-[A-Za-z0-9.-]+|[A-Za-z0-9._-]+ • (off|minimal|low|medium|high|xhigh|max)'
detect_model() { # pane
  tmux capture-pane -p -t "$1" 2>/dev/null | sed '/^[[:space:]]*$/d' | tail -n 6 \
    | grep -oE "$MODEL_RE" | sed 's/ • .*//' | tail -n 1 || true
}
refresh_model() { # pane
  local m; m=$(detect_model "$1")
  [ -z "$m" ] || tmux set-option -p -t "$1" @crew_model "$m" 2>/dev/null || true
}

# A pane id outlives its crew: after a tmux server restart ids are reused,
# so %7 may now be someone else's session. Before typing into or closing a
# pane, check it still carries this crew's labels. Pre-guard crews have no
# @crew_session; for those the role label alone must match.
owns_pane() { # pane role
  local got
  got=$(tmux display-message -p -t "$1" '#{@crew_session}	#{@crew_role}' 2>/dev/null) || return 1
  [ "$got" = "$S	$2" ] || [ "$got" = "	$2" ]
}

label_pane() { # pane role cli
  tmux set-option -p -t "$1" @crew_session "$S"
  tmux set-option -p -t "$1" @crew_role "$2"
  tmux set-option -p -t "$1" @crew_cli "$(short_cli "$3")"
  tmux set-option -p -t "$1" @crew_status ""
}
unlabel_pane() { # pane — detach it from the crew without closing it
  local opt
  for opt in @crew_session @crew_role @crew_cli @crew_status @crew_model; do
    tmux set-option -p -u -t "$1" "$opt" 2>/dev/null || true
  done
}

style_window() { # window
  tmux set-option -w -t "$1" pane-border-status top
  tmux set-option -w -t "$1" pane-border-format \
    ' #{?@crew_role,#[bold]#{@crew_role}#[nobold] · #{@crew_cli}#{?@crew_model, #{@crew_model},} · #{pane_id}#{?@crew_status, · #{@crew_status},},#{pane_title}} '
}

set_pane_status() { # role text
  local p; p=$(pane_of "$1")
  [ -n "$p" ] && owns_pane "$p" "$1" && tmux set-option -p -t "$p" @crew_status "$2" 2>/dev/null || true
}

wait_ready() { # pane — wait until the pane's screen stops changing
  local prev="" cur i=0 stable=0
  while [ "$i" -lt "$BOOT_WAIT" ]; do
    sleep 1; i=$((i + 1))
    cur=$(tmux capture-pane -p -t "$1" 2>/dev/null | cksum) || return 1
    if [ "$cur" = "$prev" ] && [ "$i" -ge 3 ]; then
      stable=$((stable + 1)); [ "$stable" -ge 2 ] && return 0
    else stable=0; fi
    prev="$cur"
  done
}

split_agent_pane() { # role window cwd -> pane; serialize the shared tiled layout update
  local role="$1" win="$2" cwd="$3" pane guard="$D/.spawn-window.lock"
  take_lock "$guard" 50 || die 'spawn window layout is locked'
  if ! pane=$(tmux split-window -d -P -F '#{pane_id}' -t "$win" -c "$cwd" \
    -e "CREW_SESSION=$S" -e "CREW_AGENT=$role" -e "CREW_HOME=$CREW_HOME"); then
    rmdir "$guard" 2>/dev/null || true
    return 1
  fi
  if ! tmux select-layout -t "$win" tiled >/dev/null; then
    tmux kill-pane -t "$pane" 2>/dev/null || true
    rmdir "$guard" 2>/dev/null || true
    return 1
  fi
  rmdir "$guard" 2>/dev/null || true
  printf '%s' "$pane"
}

# ---------- session setup ----------

check_name() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || die "bad name: $1"; }

# Run before anything is created, so a bad spec can't leave a half-made crew.
check_roles() { # role=value ...
  local seen=" " spec role
  for spec in "$@"; do
    role="${spec%%=*}"; check_name "$role"
    [ -n "${spec#*=}" ] || die "nothing given for $role"
    case "$seen" in *" $role "*) die "duplicate role: $role" ;; esac
    seen="$seen$role "
  done
}

init_dir() { # name
  S="$1"; D="$CREW_HOME/$S"
  if [ -d "$D" ] && [ ! -f "$D/ended" ]; then die "crew '$S' is still up (crew -s $S down first)"; fi
  if [ -d "$D" ]; then mv "$D" "$D.$(date +%Y%m%d-%H%M%S)"; fi
  mkdir -p "$D/inbox" "$D/out" "$D/roles"
  : > "$D/panes"; : > "$D/board.tsv"; : > "$D/channel.log"
}

sed_esc() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }  # safe as sed s||| replacement

write_role_file() { # role — always render from templates; roster is a live file pointer
  local r="$1" base tpl
  base=$(printf '%s' "$r" | sed 's/[0-9]*$//')
  tpl="$CREW_SHARE/roles/$r.md"
  [ -f "$tpl" ] || tpl="$CREW_SHARE/roles/$base.md"
  [ -f "$tpl" ] || tpl="$CREW_SHARE/roles/default.md"
  cat "$CREW_SHARE/protocol.md" "$tpl" \
    | sed -e "s|{{ROLE}}|$(sed_esc "$r")|g" -e "s|{{SESSION}}|$(sed_esc "$S")|g" \
          -e "s|{{DIR}}|$(sed_esc "$D")|g" -e "s|{{ROSTER}}|$(sed_esc "$D/panes")|g" \
    > "$D/roles/$r.md"
}
write_role_files() {
  local r; for r in $(roles); do write_role_file "$r"; done
}

intro() { # role pane — never typed into a startup dialog (see in_dialog)
  local msg="You are agent '$1' in crew '$S'. Read $D/roles/$1.md now and follow it for the rest of this session. Do not reply until you receive a task." why
  owns_pane "$2" "$1" || { echo "crew: not introducing $1 ($2): pane is gone or reused" >&2; return 0; }
  if [ "$2" = "${TMUX_PANE:-}" ]; then
    printf '%s\n' "$msg"
  elif in_dialog "$2"; then
    echo "crew: $1 ($2) is showing a startup dialog; answer it there yourself, then: crew -s $S send $1 \"$msg\"" >&2
  else
    why=$(ring --role "$1" "$2" "[crew] $msg") || true
    if [ -n "$why" ]; then
      echo "crew: nothing typed into $1 ($2): $why. Send the intro yourself when the pane is free: crew -s $S send $1 \"$msg\"" >&2
    else
      intro_submit "$1" "$2" "[crew] $msg"
    fi
  fi
}

# ring's Enter can be swallowed while a CLI is still starting (seen with pi:
# the intro sat as a draft and held every later doorbell for hours). Wait,
# then press Enter once more — only while the editor still holds exactly the
# line crew typed, so no other draft is ever submitted. Still a draft after
# that gets one warning with the manual keystroke; never a loop.
intro_submit() { # role pane text
  local why want got waited=0
  while :; do
    why=$(pane_hold "$2")
    case "$why" in draft"$TAB"*) ;; *) return 0 ;; esac
    [ "$waited" -lt 6 ] || break
    waited=$((waited + 1)); sleep 0.5
  done
  owns_pane "$2" "$1" || { echo "crew: not submitting $1 ($2): pane is gone or reused" >&2; return 0; }
  got=$(draft_text "$2") || return 0          # unreadable again: leave the draft alone
  [ -n "$got" ] || return 0                    # cleared since the pane_hold check
  want=$(printf '%s' "$3" | tr -d '[:space:]'); got=$(printf '%s' "$got" | tr -d '[:space:]')
  if [ "$got" != "$want" ]; then
    echo "crew: $1 ($2) holds a draft that is not crew's startup line; not pressing Enter. Submit it yourself when ready: tmux send-keys -t $2 Enter" >&2
    return 0
  fi
  tmux send-keys -t "$2" Enter
  waited=0
  while [ "$waited" -lt 6 ]; do
    sleep 0.5; waited=$((waited + 1))
    case "$(pane_hold "$2")" in draft"$TAB"*) ;; *) return 0 ;; esac
  done
  echo "crew: $1 ($2) still holds an unsubmitted startup draft after a second Enter; doorbells to it will be held until it is submitted. Submit it yourself: tmux send-keys -t $2 Enter" >&2
}

warn_codex_sandbox() { # role spec
  case "$2" in
    codex|codex\ *) case "$2" in *dangerously*|*network_access*) ;; *)
      echo "crew: $1 (codex) is sandboxed, so its 'crew send' can't reach tmux and its messages won't ring. Start it with flags that allow that." >&2 ;;
    esac ;;
  esac
}

start_agent() { # role pane spec — never amend the user's command
  owns_pane "$2" "$1" || die "$1's pane is gone or reused; no command typed"
  ring --now "$2" "$3"
  warn_codex_sandbox "$1" "$3"
}

settle_agent() { # role pane
  wait_ready "$2" || echo "crew: $1 did not settle in ${BOOT_WAIT}s, sending intro anyway" >&2
  owns_pane "$2" "$1" || return 0
  # A shell error in the verbatim spec leaves only the shell running. A live
  # pane always lists its shell, so no processes at all means ps is blocked
  # (e.g. a sandboxed caller): we can't tell, so don't call it a failure.
  local tty; tty=$(tmux display-message -p -t "$2" '#{pane_tty}' 2>/dev/null)
  if [ -z "$(ps -o pid= -t "${tty#/dev/}" 2>/dev/null)" ]; then
    echo "crew: can't list $1's processes ($2; ps blocked, e.g. by a sandbox); sending intro anyway" >&2
    intro "$1" "$2"; refresh_model "$2"
  elif [ -z "$(detect_cli "$2")" ]; then
    echo "crew: $1 ($2) is back at a shell prompt, so its command failed; no intro sent. Last line: $(tmux capture-pane -p -t "$2" | sed '/^[[:space:]]*$/d' | tail -n 1). Quote any [...] or * in the role spec, then rebind the role or restart the crew." >&2
  else intro "$1" "$2"; refresh_model "$2"; fi
}

cmd_up() {
  local name="" target="" self="" here=0 no_watch=0 wake_on_limit=0 handover="" max_wait="" specs=() spec role cli pane win="" origin created_at created_epoch launch_time caller="${TMUX_PANE:-}" self_cli="" watch_every=$watch_interval watch_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --in) target="$2"; shift 2 ;;
      --self) self="$2"; shift 2 ;;
      --here) here=1; shift ;;
      --no-watch) no_watch=1; shift ;;
      --wake-on-limit) wake_on_limit=1; shift ;;
      --handover-on-limit) [ $# -ge 2 ] || die "$1 needs a CLI spec"; handover="$2"; wake_on_limit=1; shift 2 ;;
      --max-wait) [ $# -ge 2 ] || die "$1 needs a duration"; max_wait="$2"; shift 2 ;;
      -*) die "unknown option: $1" ;;
      *=*) specs+=("$1"); shift ;;
      *) [ -z "$name" ] || die "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] && [ ${#specs[@]} -gt 0 ] || die 'usage: crew up <name> [--self <role>] [--here] [--no-watch] role=cli ...'
  if [ -n "${CREW_WATCH_EVERY:-}" ]; then
    watch_every=$(duration "$CREW_WATCH_EVERY") || die "bad CREW_WATCH_EVERY: $CREW_WATCH_EVERY"
    [ "$watch_every" -gt 0 ] || die "bad CREW_WATCH_EVERY: $CREW_WATCH_EVERY"
  fi
  check_name "$name"
  if [ -n "$self" ] || [ "$here" = 1 ]; then
    [ -n "$caller" ] || die "--self and --here must run inside a tmux pane"
    caller=$(pane_id "$caller") || die "TMUX_PANE=$TMUX_PANE is not a live pane; run --self/--here from the agent's actual tmux pane"
  fi
  check_roles ${self:+"$self=$caller"} "${specs[@]}"
  max_wait=$(limit_handover_options "$handover" "$max_wait") || exit 1
  if [ "$wake_on_limit" = 1 ]; then
    [ "$no_watch" = 0 ] || die '--wake-on-limit/--handover-on-limit conflict with --no-watch'
    { [ "$self" = lead ] || printf '%s\n' "${specs[@]}" | grep -q '^lead='; } || die '--wake-on-limit/--handover-on-limit need a lead role'
  fi
  if [ -z "$target" ]; then
    [ -n "${TMUX:-}" ] || die "run inside tmux, or pass --in <tmux-session>"
    target=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S')
  fi
  init_dir "$name"

  if [ -n "$self" ]; then
    self_cli=$(pane_cli "$caller")
    case "$(short_cli "$self_cli")" in
      tail|head|less|more|cat)
        echo "crew: --self sees '$self_cli' in $caller, which may be a temporary command pane. Check the binding below; use crew -s $S rebind $self <agent-pane> if needed." >&2 ;;
    esac
    label_pane "$caller" "$self" "$self_cli"
    refresh_model "$caller"
    style_window "$(tmux display-message -p -t "$caller" '#{window_id}')"
    printf '%s\t%s\t%s\t%s\n' "$self" "$caller" "$self_cli" adopted >> "$D/panes"
  fi
  [ "$here" = 0 ] || win=$(tmux display-message -p -t "$caller" '#{window_id}')

  for spec in "${specs[@]}"; do
    role="${spec%%=*}"; cli="${spec#*=}"
    if [ -z "$win" ]; then
      pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$target:" -n "$name" -c "$PWD" \
        -e "CREW_SESSION=$S" -e "CREW_AGENT=$role" -e "CREW_HOME=$CREW_HOME")
      win=$(tmux display-message -p -t "$pane" '#{window_id}')
    else
      pane=$(split_agent_pane "$role" "$win" "$PWD") || die "could not split a pane for '$role'"
    fi
    label_pane "$pane" "$role" "$cli"
    printf '%s\t%s\t%s\t%s\n' "$role" "$pane" "$cli" spawned >> "$D/panes"
  done
  style_window "$win"
  created_epoch=$(date +%s); created_at=$(now)
  printf 'mode=up\nwindow=%s\nhere=%s\ntmux_session=%s\ncreated=%s\ncreated_epoch=%s\ncwd=%s\n' \
    "$win" "$here" "$target" "$created_at" "$created_epoch" "$PWD" > "$D/meta"
  printf '%s\n' "$S" > "$CREW_HOME/.current"
  write_role_files
  log_line sys - - "crew up $S in $target · $(roles | tr '\n' ' ')"

  while IFS="$(printf '\t')" read -r role pane cli origin; do
    [ "$origin" = spawned ] || continue
    launch_time=$(date +%s)
    lock panes
    session_record_launch "$role" "$launch_time" || true
    unlock
    start_agent "$role" "$pane" "$cli"
  done < "$D/panes"
  echo "crew '$S': started ${#specs[@]} agents in $target:$win; waiting for them to settle..."
  while IFS="$(printf '\t')" read -r role pane cli origin; do
    [ "$origin" = spawned ] || continue
    settle_agent "$role" "$pane" &
  done < "$D/panes"
  wait
  # Anything after this point must not fail the crew: the panes and files are
  # already up, so a watcher that cannot start is a warning, not an error.
  if [ "$no_watch" = 0 ] && [ -n "$(pane_of lead)" ]; then
    # The subshell keeps a die, lock or trap inside timer_create from ending `up`.
    watch_id=$(timer_add_watch "$watch_every" lead "$wake_on_limit" "$handover" "$max_wait") || {
      echo "crew: could not start the watcher (crew watch --ring still works)" >&2; watch_id=""; }
  fi
  if [ -z "$self" ] && [ "$here" = 0 ] && [ -z "${CREW_NO_SWITCH:-}" ] && [ -n "${TMUX:-}" ]; then
    tmux select-window -t "$win" 2>/dev/null || true
  fi
  echo "ready. files: $D"
  [ -z "$watch_id" ] || echo "watch: $watch_id (rings lead; crew timers lists it, crew down stops it)"
  if [ -n "$self" ]; then
    echo "self: $self bound to $caller ($self_cli, adopted)"
    echo
    echo "You are agent '$self' in crew '$S'. Read $D/roles/$self.md now and follow it for the rest of this session."
  fi
}

resolve_pane_specs() { # adopt|add role=value ... → caller's specs (role|pane|origin|cli)
  local mode="$1" spec role pane cli origin seen=" "; shift
  specs=()
  for spec in "$@"; do
    role="${spec%%=*}"; cli="${spec#*=}"; pane=""; origin=spawned
    case "$mode:$cli" in adopt:*|add:%*)
      pane=$(pane_id "$cli") || die "no tmux pane '$cli'"
      case "$seen" in *" $pane "*) die "pane $pane given twice" ;; esac
      seen="$seen$pane "; origin=adopted; cli=$(pane_cli "$pane") ;;
    esac
    # CLI is last so read preserves any literal pipes in the command.
    specs+=("$role|$pane|$origin|$cli")
  done
}

crew_window() { # stored window when still owned, else the first owned pane's window
  local stored first="" role pane cli origin win
  stored=$(meta window)
  while IFS="$(printf '\t')" read -r role pane cli origin; do
    owns_pane "$pane" "$role" || continue
    win=$(tmux display-message -p -t "$pane" '#{window_id}')
    [ -n "$first" ] || first="$win"
    if [ "$win" = "$stored" ]; then printf '%s' "$win"; return; fi
  done < "$D/panes"
  [ -n "$first" ] || die 'no owned crew window; rebind an agent or add an existing pane first'
  printf '%s' "$first"
}

cmd_adopt() {
  local name="" specs=() spec role pane cli origin
  local created_at created_epoch
  while [ $# -gt 0 ]; do
    case "$1" in
      *=*) specs+=("$1"); shift ;;
      *) [ -z "$name" ] || die "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] && [ ${#specs[@]} -gt 0 ] || die 'usage: crew adopt <name> role=<pane> ...'
  check_name "$name"
  check_roles "${specs[@]}"
  resolve_pane_specs adopt "${specs[@]}"
  init_dir "$name"
  for spec in "${specs[@]}"; do
    IFS='|' read -r role pane origin cli <<< "$spec"
    label_pane "$pane" "$role" "$cli"
    refresh_model "$pane"
    style_window "$(tmux display-message -p -t "$pane" '#{window_id}')"
    printf '%s\t%s\t%s\t%s\n' "$role" "$pane" "$cli" adopted >> "$D/panes"
  done
  created_epoch=$(date +%s); created_at=$(now)
  printf 'mode=adopt\ncreated=%s\ncreated_epoch=%s\ncwd=%s\n' "$created_at" "$created_epoch" "$PWD" > "$D/meta"
  printf '%s\n' "$S" > "$CREW_HOME/.current"
  write_role_files
  log_line sys - - "crew adopt $S · $(roles | tr '\n' ' ')"
  while IFS="$(printf '\t')" read -r role pane cli origin; do intro "$role" "$pane"; done < "$D/panes"
  echo "crew '$S': adopted $(roles | wc -l | tr -d ' ') panes. files: $D"
}

cmd_add() {
  resolve_session; resolve_me
  local requested=() specs=() launch_specs=() role_cwds=() spec spec_cwd spawn_dir role cli launch_cli source_role source_cli id pane origin got i new_roles="" win="" cwd="" spawn_cwd needs_spawn=0 launch_time
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) [ $# -ge 2 ] && [ -n "$2" ] || die '--cwd needs a directory'; cwd="$2"; shift 2 ;;
      -*) die "bad option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done
  [ ${#requested[@]} -gt 0 ] || die 'usage: crew add [--cwd <dir>] role=<cli spec|%pane|fork:role> ...'
  for spec in "${requested[@]}"; do
    case "$spec" in *=*) ;; *) die "expected role=<cli spec|%pane|fork:role>: $spec" ;; esac
  done
  # --cwd is where the added roles work: their new panes start there and it is
  # recorded for the role, so gates and session lookups follow the worktree.
  [ -z "$cwd" ] || cwd=$(resolve_cwd_arg --cwd "$cwd")
  check_roles "${requested[@]}"
  lock panes
  [ ! -f "$D/ended" ] || die "crew '$S' has ended"
  # A fork uses the source role's exact native session while retaining its CLI
  # spec in the roster for future resume and status operations.
  for spec in "${requested[@]}"; do
    role="${spec%%=*}"; cli="${spec#*=}"; launch_cli="$cli"; spec_cwd="$cwd"
    case "$cli" in
      fork:*)
        source_role="${cli#fork:}"
        check_name "$source_role"
        source_cli=$(session_role_cli "$source_role")
        [ -n "$source_cli" ] || die "no source agent '$source_role' in crew $S"
        id=$(session_id_for_role "$source_role")
        launch_cli=$(session_fork_command "$source_cli" "$id")
        # A fork continues the source conversation, so it starts in the source
        # role's directory (which may be another worktree) unless --cwd says
        # otherwise. A plain role keeps the crew's project directory.
        [ -n "$spec_cwd" ] || spec_cwd=$(role_cwd "$source_role")
        cli="$source_cli" ;;
    esac
    specs+=("$role=$cli")
    launch_specs+=("$launch_cli")
    role_cwds+=("$spec_cwd")
  done
  resolve_pane_specs add "${specs[@]}"
  # Validate the entire batch under the same lock as rebind and override.
  for spec in "${specs[@]}"; do
    IFS='|' read -r role pane origin cli <<< "$spec"
    [ -z "$(pane_of "$role")" ] || die "duplicate role: $role"
    if [ "$origin" = adopted ]; then
      got=$(awk -F'\t' -v p="$pane" '$2==p{print $1; exit}' "$D/panes")
      [ -z "$got" ] || die "$pane is already '$got' in this crew"
      got=$(tmux display-message -p -t "$pane" '#{@crew_session}/#{@crew_role}')
      [ "$got" = / ] || die "$pane is already labelled $got; use an unlabelled pane"
    else
      needs_spawn=1
    fi
    new_roles="${new_roles:+$new_roles }$role"
  done
  if [ "$needs_spawn" = 1 ]; then win=$(crew_window); fi
  for i in "${!specs[@]}"; do
    IFS='|' read -r role pane origin cli <<< "${specs[$i]}"
    if [ "$origin" = spawned ]; then
      spawn_dir="${role_cwds[$i]}"
      if [ -z "$spawn_dir" ]; then
        [ -n "$spawn_cwd" ] || spawn_cwd=$(meta cwd)
        spawn_dir="$spawn_cwd"
      fi
      [ -d "$spawn_dir" ] || die "working directory for $role is missing: $spawn_dir"
      pane=$(split_agent_pane "$role" "$win" "$spawn_dir") || die "could not split a pane for '$role'"
      specs[$i]="$role|$pane|$origin|$cli"
    fi
    label_pane "$pane" "$role" "$cli"
    style_window "$(tmux display-message -p -t "$pane" '#{window_id}')"
    printf '%s\t%s\t%s\t%s\n' "$role" "$pane" "$cli" "$origin" >> "$D/panes"
    [ -z "${role_cwds[$i]}" ] || record_role_cwd "$role" "${role_cwds[$i]}"
    [ "$origin" = spawned ] || session_forget "$role"
    write_role_file "$role"
  done
  log_line sys "$ME" - "$ME added agents to $S: $new_roles"
  for i in "${!specs[@]}"; do
    IFS='|' read -r role pane origin cli <<< "${specs[$i]}"
    [ "$origin" = spawned ] || continue
    launch_time=$(date +%s)
    session_record_launch "$role" "$launch_time" || true
    start_agent "$role" "$pane" "${launch_specs[$i]}"
  done
  unlock
  for spec in "${specs[@]}"; do
    IFS='|' read -r role pane origin cli <<< "$spec"
    if [ "$origin" = spawned ]; then
      settle_agent "$role" "$pane" &
    else
      intro "$role" "$pane"
      refresh_model "$pane"
    fi
  done
  wait
  echo "crew '$S': added ${#specs[@]} agents. files: $D"
}

# ---------- messaging ----------

# The message always lands in the inbox; the ring is best-effort. A ring
# that isn't made is logged, so the timeline shows who never got a doorbell.
deliver() { # role text label [expected-pane]
  local pane line why queued=""
  pane=$(pane_of "$1")
  if [ -n "${4:-}" ] && [ "$pane" != "$4" ]; then
    log_line sys "$ME" "$1" "wake skipped: $1 moved from $4 to $pane"
    return 0
  fi
  printf '\n## %s  %s → %s\n\n%s\n' "$(now)" "$(sender_label)" "$3" "$2" >> "$D/inbox/$1.md"
  if ! owns_pane "$pane" "$1"; then why="pane $pane is gone or now belongs to something else"
  elif [ "$pane" = "${TMUX_PANE:-}" ]; then printf '%s\n' "$2"; return 0
  else
    refresh_model "$pane"
    line=$(oneline "$2")
    [ ${#line} -le "$RING_MAX" ] || line="long message; see: crew inbox --last"
    # A held doorbell becomes one pending re-ring for this role; an inline ring
    # that succeeds says nothing about older held messages, so it leaves that
    # backlog to the watcher's explicit reminder (no silent drop, no claim).
    why=$(ring --role "$1" "$pane" "[crew] $(sender_label) → $3: $line") || true
    [ -n "$why" ] || return 0
    if pending_add "$1"; then queued='; one re-ring pending'
    else queued="; re-ring not recorded, $D/pending/.$1.lock is held (remove it if its holder is gone)"; fi
  fi
  echo "crew: not ringing $1: $why (saved to inbox/$1.md$queued)" >&2
  log_line sys "$ME" "$1" "$1 not rung: $why; message is in inbox/$1.md$queued"
}

cmd_send() {
  resolve_session; resolve_me
  [ $# -ge 2 ] || die 'usage: crew send <role[,role…]|@all|you> <message>'
  # An outside caller still gets through (advisory label), but must see why.
  if [ "$ME" = outside ] && [ -z "${OUTSIDE_WARNED:-}" ]; then
    OUTSIDE_WARNED=1
    printf 'crew: sending as outside (not in crew %s): %s; see: crew -s %s whoami\n' "$S" "$WHY" "$S" >&2
  fi
  local to="$1" r list; shift
  local text="$*"
  case "$to" in
    *,*)  # several recipients: check them all, then one plain send each
      IFS=, read -r -a list <<< "$to"
      for r in "${list[@]}"; do
        [ "$r" = you ] || [ -n "$(pane_of "$r")" ] || die "no agent '$r' in crew $S (have: $(roles | tr '\n' ' ')you)"
        [ "$r" != "$ME" ] || die "can't send to yourself"
      done
      for r in "${list[@]}"; do cmd_send "$r" "$text"; done ;;
    @all)
      [ "$ME" = lead ] || [ "$ME" = you ] || die "only lead or you can broadcast"
      log_line all "$ME" all "$text"
      for r in $(roles); do [ "$r" = "$ME" ] || deliver "$r" "$text" "@all"; done ;;
    you)
      log_line dm "$ME" you "$text"
      printf '\n## %s  %s → you\n\n%s\n' "$(now)" "$ME" "$text" >> "$D/inbox/you.md"
      tmux display-message -d 8000 "crew $S · $ME → you: $(oneline "$text")" 2>/dev/null || true ;;
    *)
      [ -n "$(pane_of "$to")" ] || die "no agent '$to' in crew $S (have: $(roles | tr '\n' ' ')you)"
      [ "$to" != "$ME" ] || die "can't send to yourself"
      log_line dm "$ME" "$to" "$text"
      deliver "$to" "$text" "$to" ;;
  esac
}

cmd_say() {
  resolve_session; resolve_me
  [ "$ME" = you ] || die "crew say is for the human at a terminal; here you are '$ME'. Agents use crew send. For the human: run crew -s $S say <role> \"<message>\" from a terminal outside the crew's panes, or use crew -s $S web --allow-send."
  [ $# -ge 2 ] || die 'usage: crew say <role[,role…]|@all> <message>'
  cmd_send "$@"
}

cmd_note() {
  resolve_session; resolve_me
  [ $# -ge 1 ] || die 'usage: crew note <text>'
  log_line sys "$ME" - "note ($ME): $*"
}

# ---------- tasks ----------

# board.tsv and panes are rewritten in place, so writers take a mkdir lock.
lock() { # names (board | panes); all acquired locks share one cleanup path
  local name
  for name in "$@"; do
    take_lock "$D/.$name.lock" 50 || die "$name is locked (remove $D/.$name.lock if it's stale)"
    HELD_LOCKS="${HELD_LOCKS:+$HELD_LOCKS }$name"
    trap unlock EXIT
  done
}
unlock() {
  local name
  for name in ${HELD_LOCKS:-}; do rmdir "$D/.$name.lock" 2>/dev/null || true; done
  HELD_LOCKS=""
  trap - EXIT
}

cmd_board() {
  resolve_session
  if [ ! -s "$D/board.tsv" ]; then echo "(no tasks)"; return; fi
  # The board is for reading, not operating: gate ($8) and task cwd ($9) are
  # command metadata reachable through task/task-gate diagnostics, and STAY
  # out of the display; columns stay id→title with EVIDENCE last.
  { printf 'ID\tOWNER\tSTATUS\tNEEDS\tOUTPUT\tEVIDENCE\tTITLE\n'
    awk -F'\t' -v OFS='\t' '{print $1, $2, $3, $4, $5, ($7 == "" ? "-" : $7), $6}' "$D/board.tsv"
  } | column -t -s "$(printf '\t')"
}

# ---------- repair ----------

# The opted-in usage-limit watcher hands lead over as `watch`; that identity
# comes only from limit_handover_by, which main clears before dispatch.
override_identity() {
  resolve_me
  [ -z "${limit_handover_by:-}" ] || { ME=$limit_handover_by; VIA=""; }
}
override_caller_ok() {
  [ "$ME" = you ] || [ "$ME" = lead ] || { [ "$ME" = watch ] && [ "${limit_handover_by:-}" = watch ]; }
}

cmd_override() {
  resolve_session; override_identity
  local form_eq=0 arg1="" arg2="" role="" replacement="" cmdline
  if [ $# -eq 2 ]; then
    arg1="$1"; arg2="$2"; role="$arg1"; replacement="$arg2"
    printf -v cmdline 'crew -s %q override %q %q' "$S" "$arg1" "$arg2"
  elif [ $# -eq 1 ]; then
    case "$1" in
      *=*) form_eq=1; role="${1%%=*}"; replacement="${1#*=}"
        printf -v cmdline 'crew -s %q override %q' "$S" "$1" ;;
      *) die 'usage: crew override <role> <replacement-role|pane> | <role>=<cli spec>' ;;
    esac
  else die 'usage: crew override <role> <replacement-role|pane> | <role>=<cli spec>'
  fi
  local old new caller="$ME" context handover="" msg r p cli origin=adopted swap=1 win="" cwd="" previous refusal got launch_time=""
  refusal="only lead or you can override a role
  run: $cmdline"
  check_name "$role"
  [ -n "$replacement" ] || die 'replacement must not be empty'
  override_caller_ok || die "$refusal"
  [ "$role" != "$replacement" ] || die 'replacement must be a different role'
  [ ! -f "$D/ended" ] || die "crew '$S' has ended"
  lock panes board
  override_identity
  caller="$ME"
  override_caller_ok || die "$refusal"
  old=$(pane_of "$role"); [ -n "$old" ] || die "no agent '$role' in crew $S"
  owns_pane "$old" "$role" || die "$role's pane is stale; rebind it first"
  new=$(pane_of "$replacement")
  if [ -n "$new" ]; then
    swap=1
    owns_pane "$new" "$replacement" || die "$replacement's pane is stale; rebind it first"
  elif [ "$form_eq" = 1 ] && [ "${replacement#%}" = "$replacement" ]; then
    swap=0
    win=$(crew_window)
    cwd=$(role_cwd "$role"); [ -d "$cwd" ] || die "crew working directory is missing: $cwd"
    unlock
    if ! new=$(split_agent_pane "$role" "$win" "$cwd"); then
      die "could not split a pane for '$role'"
    fi
    warn_codex_sandbox "$role" "$replacement"
    launch_time=$(date +%s)
    if ! ring --now "$new" "$replacement"; then
      tmux kill-pane -t "$new" 2>/dev/null || true
      die "could not start '$replacement'; successor pane closed"
    fi
    wait_ready "$new" || true
    if [ -z "$(detect_cli "$new")" ]; then
      tmux kill-pane -t "$new" 2>/dev/null || true
      die "successor '$replacement' did not start; nothing changed"
    fi
    cli="$replacement"; origin=spawned
    lock panes board
    override_identity
    caller="$ME"
    if ! override_caller_ok; then
      tmux kill-pane -t "$new" 2>/dev/null || true
      die "$refusal"
    fi
    if [ -f "$D/ended" ] || [ "$(pane_of "$role")" != "$old" ] \
      || [ -n "$(pane_of "$replacement")" ] \
      || [ -n "$(awk -F'\t' -v p="$new" '$2==p{print $1; exit}' "$D/panes")" ] \
      || [ "$(tmux display-message -p -t "$new" '#{@crew_session}/#{@crew_role}' 2>/dev/null || true)" != / ] \
      || [ -z "$(detect_cli "$new")" ] || ! owns_pane "$old" "$role"; then
      tmux kill-pane -t "$new" 2>/dev/null || true
      die "crew changed while '$replacement' started; retry the override"
    fi
  else
    swap=0
    new=$(pane_id "$replacement") || die "no agent or tmux pane '$replacement'"
    got=$(awk -F'\t' -v p="$new" '$2==p{print $1; exit}' "$D/panes")
    [ -z "$got" ] || die "$new is already '$got' in this crew; use its role"
    got=$(tmux display-message -p -t "$new" '#{@crew_session}/#{@crew_role}')
    [ "$got" = / ] || die "$new is already labelled $got; use its role or an unlabelled pane"
    cli=$(pane_cli "$new")
  fi

  [ -f "$D/out/handover-$role.md" ] && handover="out/handover-$role.md"
  context="out/override-$role-$(date +%Y%m%d-%H%M%S)-$$.md"
  {
    printf '# Role handover: %s → %s\n\n' "$replacement" "$role"
    if [ -n "$handover" ]; then printf 'Read the outgoing role handover at %s.\n\n' "$handover"; fi
    if [ "$swap" = 0 ]; then
      printf 'The previous role pane is detached from the crew and kept open.\n\n'
    fi
    printf 'You now act as %s. Previous role: %s; replacement: %s. Read roles/%s.md, board.tsv, channel.log, inbox/%s.md in %s, plus relevant out/ results and evidence. Continue the existing goal; verify incomplete claims. Conversation history inside the old agent is not transferred.\n\n' \
      "$role" "$role" "$replacement" "$role" "$role" "$D"
    if [ "$swap" = 1 ]; then
      printf 'Also read inbox/%s.md for your earlier assignments.\n\n' "$replacement"
      printf 'Unfinished tasks owned by %s move to %s; existing %s tasks also remain yours. Done/cancelled tasks, result paths, evidence and history stay unchanged.\n\n' "$replacement" "$role" "$role"
    else
      printf 'Existing tasks, result paths, evidence and history stay unchanged.\n\n'
    fi
    printf '## Previous %s pane (visible output and up to 200 scrollback lines)\n\n```text\n' "$role"
    tmux capture-pane -p -J -S -200 -t "$old"
    printf '\n```\n'
  } > "$D/$context"
  if [ "$swap" = 1 ]; then
    # Swap occupants, keeping CLI and lifecycle origin attached to each pane.
    awk -F'\t' -v OFS='\t' -v r="$role" -v s="$replacement" \
      '$1==r{$1=s; print; next} $1==s{$1=r} {print}' "$D/panes" > "$D/panes.tmp"
    awk -F'\t' -v OFS='\t' -v r="$role" -v s="$replacement" -v closed="$TASK_CLOSED_RE" \
      '$2==s && $3 !~ closed{$2=r} {print}' "$D/board.tsv" > "$D/board.tsv.tmp"
    mv "$D/board.tsv.tmp" "$D/board.tsv"
    mv "$D/panes.tmp" "$D/panes"
    if [ -f "$D/cwd.tsv" ]; then
      awk -F'\t' -v OFS='\t' -v r="$role" -v s="$replacement" \
        '$1==r{$1=s; print; next} $1==s{$1=r} {print}' "$D/cwd.tsv" > "$D/cwd.tsv.tmp"
      mv "$D/cwd.tsv.tmp" "$D/cwd.tsv"
    fi
    if [ -f "$D/sessions.tsv" ]; then
      awk -F'\t' -v OFS='\t' -v r="$role" -v s="$replacement" \
        '$1==r{$1=s; print; next} $1==s{$1=r} {print}' "$D/sessions.tsv" > "$D/sessions.tsv.tmp"
      mv "$D/sessions.tsv.tmp" "$D/sessions.tsv"
    fi
  else
    awk -F'\t' -v OFS='\t' -v r="$role" -v p="$new" -v c="$cli" \
      -v o="$origin" '$1==r{$2=p; $3=c; $4=o} {print}' "$D/panes" > "$D/panes.tmp"
    mv "$D/panes.tmp" "$D/panes"
    [ "$origin" = spawned ] || session_forget "$role"
    if owns_pane "$old" "$role"; then unlabel_pane "$old"; fi
  fi
  while IFS="$(printf '\t')" read -r r p cli row_origin; do
    case "$r" in "$role"|"$replacement") label_pane "$p" "$r" "$cli" ;; esac
  done < "$D/panes"
  printf '\nWorking directory for %s: %s. Tasks keep their recorded gate directories across ownership changes.\n' \
    "$role" "$(role_cwd "$role")" >> "$D/$context"
  if [ "$origin" = spawned ]; then session_record_launch "$role" "$launch_time" || true; fi
  style_window "$(tmux display-message -p -t "$new" '#{window_id}')"
  refresh_model "$new"
  write_role_files
  unlock
  if [ "$origin" = spawned ]; then
    intro "$role" "$new"
  fi
  previous="previous $role ($old) is now $replacement"
  [ "$swap" = 1 ] || previous="previous $role ($old) detached and kept open"
  log_line sys "$caller" "$role" "$caller overrode $role: $replacement ($new) takes over; $previous; context: $D/$context"
  for r in $(roles); do
    if [ "$r" = "$role" ]; then
      msg="You are now '$role'. Read $D/roles/$role.md and $D/$context, recover the ongoing work from the board, inboxes and results, and continue."
    elif [ "$r" = "$replacement" ]; then
      msg="You are now '$replacement'; '$role' has taken over your unfinished tasks. Read $D/roles/$replacement.md. Stop your previous role's work; wait for a new assignment."
    else
      msg="Role override: $replacement ($new) is now $role; $previous. Continue your tasks and address reports to the current roles."
    fi
    log_line dm "$ME" "$r" "$msg"
    deliver "$r" "$msg" "$r"
  done
  echo "$role → $new ($previous). Handover: $D/$context"
}

cmd_rebind() {
  resolve_session; resolve_me
  local role="" ref="" intro_too=0 old new got cli
  while [ $# -gt 0 ]; do
    case "$1" in --intro) intro_too=1; shift ;; *) if [ -z "$role" ]; then role="$1"; else ref="$1"; fi; shift ;; esac
  done
  [ -n "$role" ] || die 'usage: crew rebind <role> [pane] [--intro]'
  lock panes
  old=$(pane_of "$role"); [ -n "$old" ] || die "no agent '$role' in crew $S"
  ref="${ref:-${TMUX_PANE:-}}"; [ -n "$ref" ] || die "give a pane (%7, .2) or run inside the new pane"
  new=$(pane_id "$ref") || die "no tmux pane '$ref'"
  [ "$new" != "$old" ] || die "$role is already $new"
  got=$(awk -F'\t' -v p="$new" '$2==p{print $1; exit}' "$D/panes")
  [ -z "$got" ] || die "$new is already '$got' in this crew"
  got=$(tmux display-message -p -t "$new" '#{@crew_session}/#{@crew_role}')
  [ "$got" = "/" ] || die "$new is labelled as ${got#*/} in crew ${got%%/*}; close that crew first"

  if owns_pane "$old" "$role"; then unlabel_pane "$old"; fi
  cli=$(pane_cli "$new")
  awk -F'\t' -v OFS='\t' -v r="$role" -v p="$new" -v c="$cli" '$1==r{$2=p; $3=c; $4="adopted"} {print}' "$D/panes" > "$D/panes.tmp"
  mv "$D/panes.tmp" "$D/panes"
  session_forget "$role"
  label_pane "$new" "$role" "$cli"
  refresh_model "$new"
  style_window "$(tmux display-message -p -t "$new" '#{window_id}')"
  unlock
  log_line sys "$ME" "$role" "$ME rebound $role $old → $new"
  echo "$role → $new (was $old)"
  if [ "$intro_too" = 1 ]; then intro "$role" "$new"
  elif [ "$new" = "${TMUX_PANE:-}" ]; then
    echo "You are agent '$role' in crew '$S'. Read $D/roles/$role.md if you haven't."
  fi
}

cmd_session() {
  resolve_session; resolve_me
  [ $# -ge 1 ] && [ $# -le 2 ] || die 'usage: crew session <role> [session-id]'
  local role="$1" id="${2:-}"
  [ -n "$(pane_of "$role")" ] || die "no agent '$role' in crew $S"
  lock panes
  if [ -n "$id" ]; then
    record_session_id "$role" "$id"
    echo "recorded $role session $id"
  else
    id=$(session_id_for_role "$role")
    echo "$id"
  fi
  unlock
}

cmd_resume() {
  resolve_session; resolve_me
  [ $# -eq 1 ] || die 'usage: crew resume <role> (run inside a new, unbound tmux pane)'
  local role="$1" old new got labels cli agent id cwd win
  new="${TMUX_PANE:-}"
  [ -n "$new" ] || die 'crew resume must run inside a tmux pane'
  new=$(pane_id "$new") || die "no tmux pane '${TMUX_PANE:-}'"
  lock panes
  [ ! -f "$D/ended" ] || die "crew '$S' has ended"
  old=$(pane_of "$role"); [ -n "$old" ] || die "no agent '$role' in crew $S"
  # Reusing the role's own labelled pane is fine once its agent has exited.
  if owns_pane "$old" "$role"; then
    [ "$old" = "$new" ] || die "$role still has an owned pane; resume only after that pane is gone or unlabelled"
    case "$(short_cli "$(detect_cli "$new")")" in
      claude|codex|pi) die "$role's agent is still running in $new" ;;
    esac
  fi
  got=$(awk -F '\t' -v p="$new" '$2==p {print $1; exit}' "$D/panes")
  # After a tmux restart a new pane id may equal another role's dead one.
  [ -z "$got" ] || [ "$got" = "$role" ] || ! owns_pane "$new" "$got" \
    || die "$new is already '$got' in this crew"
  labels=$(tmux display-message -p -t "$new" '#{@crew_session}/#{@crew_role}')
  [ "$labels" = / ] || [ "$labels" = "$S/$role" ] || die "$new is labelled as ${labels#*/} in crew ${labels%%/*}; use an unlabelled pane"
  cli=$(session_role_cli "$role"); [ -n "$cli" ] || die "no agent '$role' in crew $S"
  agent=$(short_cli "$cli")
  case "$agent" in claude|codex|pi) ;; *) die "session resume is not supported for $agent" ;; esac
  id=$(session_id_for_role "$role")
  cwd=$(role_cwd "$role"); [ -d "$cwd" ] || die "crew working directory is missing: $cwd"
  # exec runs in this non-interactive bash, so aliases and functions don't resolve.
  command -v "${cli%% *}" >/dev/null || die "can't run '${cli%% *}' from here (aliases and functions don't apply); nothing was changed"
  awk -F '\t' -v OFS='\t' -v r="$role" -v p="$new" '$1==r {$2=p; $4="adopted"} $1!=r && $2==p {$2="%gone"} {print}' \
    "$D/panes" > "$D/panes.tmp"
  mv "$D/panes.tmp" "$D/panes"
  label_pane "$new" "$role" "$cli"
  win=$(tmux display-message -p -t "$new" '#{window_id}')
  style_window "$win"
  unlock
  log_line sys "$ME" "$role" "$ME resumed $role from $agent session $id in $new (was $old)"
  export CREW_SESSION="$S" CREW_AGENT="$role" CREW_HOME
  cd "$cwd"
  case "$agent" in
    claude) eval "exec $cli --resume $id" ;;
    codex) eval "exec $cli resume $id" ;;
    pi) eval "exec $cli --session $id" ;;
  esac
}

cmd_remove() {
  resolve_session; resolve_me
  local role="" keep=0 pane origin how open_ids kill_later=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-pane) keep=1; shift ;;
      -*) die "bad option: $1" ;;
      *) [ -z "$role" ] || die "unexpected argument: $1"; role="$1"; shift ;;
    esac
  done
  [ -n "$role" ] || die 'usage: crew remove <role> [--keep-pane]'
  [ "$role" != lead ] || die 'cannot remove lead (override it instead)'
  [ "$ME" = you ] || [ "$ME" = lead ] || die 'only lead or you can remove a role'
  [ ! -f "$D/ended" ] || die "crew '$S' has ended"
  lock panes board
  resolve_me
  [ "$ME" = you ] || [ "$ME" = lead ] || die 'only lead or you can remove a role'
  pane=$(pane_of "$role"); [ -n "$pane" ] || die "no agent '$role' in crew $S"
  origin=$(awk -F'\t' -v r="$role" '$1==r{print $4; exit}' "$D/panes")
  how="pane $pane already gone"
  if owns_pane "$pane" "$role"; then
    if [ "${origin:-spawned}" = spawned ] && [ "$keep" = 0 ]; then
      kill_later=1; how="pane $pane closed"
    else
      unlabel_pane "$pane"; how="pane $pane kept, unlabelled"
    fi
  elif pane_id "$pane" >/dev/null; then
    how="pane $pane reused; left alone"
    echo "crew: leaving $pane open: it no longer carries $role's labels" >&2
  fi
  # Nobody can finish its queued/working tasks any more: block them and name
  # them in the log line, so the board stays explainable. Both new files are
  # prepared before either is published, then moved back to back.
  open_ids=$(awk -F'\t' -v r="$role" '$2==r && ($3=="queued" || $3=="working"){print $1}' "$D/board.tsv" | tr '\n' ' ')
  awk -F'\t' -v OFS='\t' -v r="$role" '$2==r && ($3=="queued" || $3=="working"){$3="blocked"} {print}' "$D/board.tsv" > "$D/board.tsv.tmp"
  awk -F'\t' -v r="$role" '$1!=r' "$D/panes" > "$D/panes.tmp"
  mv "$D/panes.tmp" "$D/panes"
  mv "$D/board.tsv.tmp" "$D/board.tsv"
  session_forget "$role"
  forget_role_cwd "$role"
  unlock
  log_line sys "$ME" "$role" "$ME removed $role ($how); tasks blocked: ${open_ids:-none}; inbox and out/ kept"
  [ -z "$kill_later" ] || tmux kill-pane -t "$pane" 2>/dev/null || true
  echo "$role removed from $S ($how${open_ids:+; blocked: $open_ids})"
}

cmd_restyle() {
  resolve_session
  local role pane cli origin win seen=" "
  while IFS="$(printf '\t')" read -r role pane cli origin; do
    owns_pane "$pane" "$role" || continue
    win=$(tmux display-message -p -t "$pane" '#{window_id}') || continue
    case "$seen" in *" $win "*) continue ;; esac
    style_window "$win"; refresh_model "$pane"; seen="$seen$win "
  done < "$D/panes"
  echo "restyled:${seen% }"
}

# ---------- viewing ----------

fmt_log() {
  awk -F'\t' '{
    t = substr($1, 12, 8)
    if ($2 == "sys") printf "%s  · %s\n", t, $5
    else if ($2 == "all") printf "%s  %s → @all  %s\n", t, $3, $5
    else printf "%s  %s → %s  %s\n", t, $3, $4, $5
  }'
}

cmd_log() {
  resolve_session
  local follow=0 n=40
  while [ $# -gt 0 ]; do
    case "$1" in -f) follow=1; shift ;; -n) n="$2"; shift 2 ;; *) die "bad option: $1" ;; esac
  done
  if [ "$follow" = 1 ]; then tail -n "$n" -f "$D/channel.log" | fmt_log
  else tail -n "$n" "$D/channel.log" | fmt_log; fi
}

cmd_status() {
  resolve_session
  local role pane cli origin cmd last model cap observation health resources reason note draft table row note_lead=""
  printf 'crew %s  (%s)  %s\n\n' "$S" "$(meta mode)$([ -f "$D/ended" ] && echo ', ended')" "$D"
  # Keep this loop in the current shell so the lead hint reuses its row data.
  table=$(printf 'ROLE\tCLI\tMODEL\tPANE\tRUNNING\tLAST MESSAGE\tNOTE\tCONTEXT / QUOTA')
  while IFS="$(printf '\t')" read -r role pane cli origin; do
    # A dead pane id: display-message exits 0 with empty output (tmux 3.5),
    # so emptiness, not the exit code, is what makes a role "gone".
    cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)
    if [ -z "$cmd" ]; then cmd="gone"
    elif ! owns_pane "$pane" "$role"; then cmd="STALE (pane reused)"
    else cmd=$(short_cli "$cmd"); fi
    last=$(awk -F'\t' -v r="$role" '$3==r && $2!="sys"{l=substr($1,12,5) " → " $4 ": " $5} END{print l}' "$D/channel.log")
    last=$(truncate_text "$last" 70)
    model=""; note=""; resources=""; health=""; reason=""; draft=""
    if owns_pane "$pane" "$role"; then
      refresh_model "$pane"
      model=$(tmux display-message -p -t "$pane" '#{@crew_model}' 2>/dev/null) || model=""
      cap=$(pane_scan_capture "$pane" "$cli" 2>/dev/null) || cap=""
      observation=$(printf '%s\n' "$cap" | pane_observation "$(short_cli "$cli")")
      IFS='|' read -r health resources reason <<< "$observation"
      draft=$(printf '%s\n' "$cap" | draft_note "$pane" "$cli")
      if [ "$health" = error ]; then note="ERROR: $reason"
      elif [ -n "$draft" ]; then note="$draft"
      elif [ "$health" = idle ] && [ "$(role_tasks "$role" active)" -gt 0 ]; then note='IDLE with queued/working task'; fi
    fi
    if [ "$role" = lead ]; then
      case "$cmd" in
        gone|STALE*) note_lead='pane gone or reused' ;;
        *)
          case "$note" in ERROR:*|'IDLE with queued/working task') note_lead="$note" ;; esac ;;
      esac
    fi
    row=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$role" "$(short_cli "$cli")" "${model:--}" "$pane" "$cmd" "${last:--}" "${note:--}" "${resources:--}")
    table="${table}"$'\n'"${row}"
  done < "$D/panes"
  printf '%s\n' "$table" | column -t -s "$(printf '\t')"
  semaphore_status
  echo; cmd_board
  if [ -n "$note_lead" ]; then
    echo
    printf 'lead: %s\n  %s\n' "$note_lead" "$(lead_recovery_hint)"
  fi
}

cmd_peek() {
  resolve_session --read-only
  [ $# -ge 1 ] || die 'usage: crew peek <role> [lines]'
  local pane; pane=$(pane_of "$1"); [ -n "$pane" ] || die "no agent '$1'"
  owns_pane "$pane" "$1" || die "$1's pane $pane is gone or now belongs to something else (crew rebind $1 <pane>)"
  tmux capture-pane -p -J -t "$pane" -S -300 | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | tail -n "${2:-25}"
}

cmd_inbox() {
  resolve_session; resolve_me
  local role="" last="" from="" since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --last)
        shift
        case "${1:-}" in
          [0-9]*)
            case "$1" in *[!0-9]*) die "bad --last count: $1" ;; esac
            [ "$1" -ge 1 ] || die '--last needs a count of at least 1'
            last="$1"; shift ;;
          *) last=1 ;;
        esac ;;
      --from|--since)
        [ $# -ge 2 ] || die "$1 needs a value"
        case "$1" in --from) from="$2" ;; --since) since="$2" ;; esac
        shift 2 ;;
      -*) die "bad option: $1" ;;
      *) [ -z "$role" ] || die "unexpected argument: $1"; role="$1"; shift ;;
    esac
  done
  case "$since" in ""|[0-9][0-9]:[0-9][0-9]) ;; *) die '--since wants HH:MM' ;; esac
  if [ -z "$role" ]; then
    case "$ME" in you|outside) role=lead ;; *) role="$ME" ;; esac
  fi
  [ "$role" = you ] || [ -n "$(pane_of "$role")" ] \
    || die "no agent '$role' in crew $S (have: $(roles | tr '\n' ' ')you)"
  local f="$D/inbox/$role.md" out
  [ -s "$f" ] || { echo "(no messages for $role)"; return 0; }
  # Entries start with the header the writer emits — "## <ISO timestamp>  <sender>
  # → <to>" — so an H2 inside a body never splits one. --last keeps the newest
  # N matching entries.
  out=$(awk -v last="$last" -v from="$from" -v since="$since" '
    function is_header(l) {
      return l ~ /^## [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]  / && l ~ /→/
    }
    is_header($0) {
      if (cur) { n++; e[n] = buf }
      split($0, p, "  "); sender = p[2]; sub(/ → .*/, "", sender)
      cur = (since == "" || substr($0, 15, 5) >= since) \
        && (from == "" || sender == from || sender ~ ("^" from " \\("))
      buf = $0; next
    }
    { if (cur) buf = buf "\n" $0 }
    END {
      if (cur) { n++; e[n] = buf }
      start = (last != "" && n > last) ? n - last + 1 : 1
      for (i = start; i <= n; i++) print e[i]
    }' "$f")
  [ -n "$out" ] || { echo "(no messages)"; return 0; }
  printf '%s\n' "$out"
}

cmd_down() {
  resolve_session
  local role pane cli origin win last=""
  lock timers
  log_line sys - - "crew down"
  touch "$D/ended"
  timer_mark_all
  unlock
  timer_cancel_all
  [ "$(cat "$CREW_HOME/.current" 2>/dev/null)" != "$S" ] || rm -f "$CREW_HOME/.current"
  echo "crew '$S' closed; files kept in $D"
  # Close panes crew started; unlabel panes it adopted. If the caller is a
  # started pane, close it last so this script isn't killed mid-loop.
  while IFS="$(printf '\t')" read -r role pane cli origin; do
    owns_pane "$pane" "$role" || { echo "crew: leaving $pane alone ($role's pane is gone or reused)" >&2; continue; }
    if [ "${origin:-spawned}" = spawned ]; then
      if [ "$pane" = "${TMUX_PANE:-}" ]; then last="$pane"; else tmux kill-pane -t "$pane" 2>/dev/null || true; fi
      continue
    fi
    unlabel_pane "$pane"
    win=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null) || continue
    tmux set-option -w -u -t "$win" pane-border-status 2>/dev/null || true
    tmux set-option -w -u -t "$win" pane-border-format 2>/dev/null || true
  done < "$D/panes"
  [ -z "$last" ] || tmux kill-pane -t "$last" 2>/dev/null || true
}

# Listing and stale cleanup share the CLI helpers above.
. "$CREW_SHARE/listing.sh"
. "$CREW_SHARE/ui.sh"

cmd_web() {
  local port="${CREW_WEB_PORT:-7777}" open=0 allow=0
  while [ $# -gt 0 ]; do
    case "$1" in --port) port="$2"; shift 2 ;; --open) open=1; shift ;; --allow-send) allow=1; shift ;; *) die "bad option: $1" ;; esac
  done
  command -v bun >/dev/null || die "crew web needs bun (brew install oven-sh/bun/bun)"
  local url="http://127.0.0.1:$port"
  [ -n "${SESSION_FLAG:-}" ] && url="$url/?s=$SESSION_FLAG"
  [ "$open" = 0 ] || ( sleep 1; open "$url" ) &
  CREW_HOME="$CREW_HOME" CREW_WEB_PORT="$port" CREW_WEB_ALLOW_SEND="$allow" CREW_BIN="$_self" \
    exec bun "$CREW_SHARE/web.ts"
}

# ---------- main ----------

SESSION_FLAG=""
limit_handover_by="" # set only by limit_handover_lead, never inherited
if [ "${1:-}" = -s ]; then SESSION_FLAG="${2:-}"; shift 2 || die "-s needs a name"; fi
cmd="${1:-help}"; shift || true
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
case "$cmd" in
  up) cmd_up "$@" ;;
  adopt) cmd_adopt "$@" ;;
  add) cmd_add "$@" ;;
  send) cmd_send "$@" ;;
  say) cmd_say "$@" ;;
  note) cmd_note "$@" ;;
  rebind) cmd_rebind "$@" ;;
  session) cmd_session "$@" ;;
  resume) cmd_resume "$@" ;;
  remove) cmd_remove "$@" ;;
  override) cmd_override "$@" ;;
  restyle) cmd_restyle ;;
  task) cmd_task "$@" ;;
  lock) cmd_lock "$@" ;;
  board) cmd_board ;;
  status) cmd_status ;;
  ui) cmd_ui "$@" ;;
  _ui-state) cmd_ui_state "$@" ;;
  _ui-jump) cmd_ui_jump "$@" ;;
  watch) cmd_watch "$@" ;;
  at|every) cmd_timer_add "$cmd" "$@" ;;
  timers) cmd_timers "$@" ;;
  _timer) cmd_timer_run "$@" ;;
  log) cmd_log "$@" ;;
  peek) cmd_peek "$@" ;;
  inbox) cmd_inbox "$@" ;;
  web) cmd_web "$@" ;;
  down) cmd_down ;;
  ls) cmd_ls "$@" ;;
  sweep) cmd_sweep "$@" ;;
  whoami)
    resolve_session; resolve_me; echo "$ME in crew $S"
    echo "why: $WHY"
    if [ -n "${TMUX_PANE:-}" ] && { [ "$ME" = outside ] || [ "$ME" = you ]; } \
      && [ -z "$(awk -F'\t' -v p="$TMUX_PANE" '$2==p' "$D/panes")" ]; then
      echo "crew: pane $TMUX_PANE isn't in crew $S; if an agent moved here: crew rebind <role>" >&2
    fi ;;
  path) resolve_session; echo "$D" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
